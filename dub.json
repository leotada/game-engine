{
    "name": "game-engine",
    "description": "Modern 3D game engine in D — WGPU + SDL3",
    "authors": ["Leonardo Tada"],
    "copyright": "Copyright © 2022-2026, Leonardo Tada",
    "license": "proprietary",

    "sourcePaths": ["source/engine", "source/bindings", "source/demo"],
    "importPaths": ["source", "source/bindings/box3d"],

    "dflags-dmd": ["-preview=dip1000", "-P-std=c17", "-P-Ivendor/box3d/include"],
    "dflags-ldc": ["-preview=dip1000", "-P-std=c17", "-P-Ivendor/box3d/include"],

    "sourceFiles": ["source/bindings/box3d/box3d_import.c"],
    "libs": ["SDL3", "wgpu_native", "box3d", "m"],
    "lflags-linux": ["-L./libs"],

    "configurations": [
        {
            "name": "demo",
            "targetType": "executable",
            "targetName": "game-engine-demo",
            "mainSourceFile": "source/demo/main.d",
            "excludedSourceFiles": ["source/demo/benchmark.d", "source/demo/benchmark2.d", "source/demo/game.d", "source/demo/showcase.d", "source/demo/editor.d", "source/demo/test_physics.d", "source/demo/test_physics_box3d.d", "source/demo/gc_benchmark.d", "source/demo/marble_run.d", "source/demo/_legacy/*"]
        },
        {
            "name": "benchmark",
            "targetType": "executable",
            "targetName": "game-engine-benchmark",
            "mainSourceFile": "source/demo/benchmark.d",
            "excludedSourceFiles": ["source/demo/main.d", "source/demo/benchmark2.d", "source/demo/game.d", "source/demo/showcase.d", "source/demo/editor.d", "source/demo/test_physics.d", "source/demo/test_physics_box3d.d", "source/demo/gc_benchmark.d", "source/demo/marble_run.d", "source/demo/_legacy/*"],
            "dflags-release-ldc": ["-O3", "-mcpu=native"],
            "dflags-release-gdc": ["-O3", "-march=native"]
        },
        {
            "name": "benchmark2",
            "targetType": "executable",
            "targetName": "game-engine-benchmark2",
            "mainSourceFile": "source/demo/benchmark2.d",
            "excludedSourceFiles": ["source/demo/main.d", "source/demo/benchmark.d", "source/demo/game.d", "source/demo/showcase.d", "source/demo/editor.d", "source/demo/test_physics.d", "source/demo/test_physics_box3d.d", "source/demo/gc_benchmark.d", "source/demo/marble_run.d", "source/demo/_legacy/*"],
            "dflags-release-ldc": ["-O3", "-mcpu=native"],
            "dflags-release-gdc": ["-O3", "-march=native"]
        },
        {
            "name": "game",
            "targetType": "executable",
            "targetName": "crystal-collector",
            "mainSourceFile": "source/demo/game.d",
            "excludedSourceFiles": ["source/demo/main.d", "source/demo/benchmark.d", "source/demo/benchmark2.d", "source/demo/showcase.d", "source/demo/editor.d", "source/demo/test_physics.d", "source/demo/test_physics_box3d.d", "source/demo/gc_benchmark.d", "source/demo/marble_run.d", "source/demo/_legacy/*"]
        },
        {
            "name": "showcase",
            "targetType": "executable",
            "targetName": "game-engine-showcase",
            "mainSourceFile": "source/demo/showcase.d",
            "excludedSourceFiles": ["source/demo/main.d", "source/demo/benchmark.d", "source/demo/benchmark2.d", "source/demo/game.d", "source/demo/editor.d", "source/demo/test_physics.d", "source/demo/test_physics_box3d.d", "source/demo/gc_benchmark.d", "source/demo/marble_run.d", "source/demo/_legacy/*"]
        },
        {
            "name": "editor",
            "targetType": "executable",
            "targetName": "game-engine-editor",
            "mainSourceFile": "source/demo/editor.d",
            "excludedSourceFiles": ["source/demo/main.d", "source/demo/benchmark.d", "source/demo/benchmark2.d", "source/demo/game.d", "source/demo/showcase.d", "source/demo/test_physics.d", "source/demo/test_physics_box3d.d", "source/demo/gc_benchmark.d", "source/demo/marble_run.d", "source/demo/_legacy/*"]
        },
        {
            "name": "test-physics",
            "targetType": "executable",
            "targetName": "game-engine-test-physics",
            "mainSourceFile": "source/demo/test_physics.d",
            "excludedSourceFiles": ["source/demo/main.d", "source/demo/benchmark.d", "source/demo/benchmark2.d", "source/demo/game.d", "source/demo/showcase.d", "source/demo/editor.d", "source/demo/test_physics_box3d.d", "source/demo/gc_benchmark.d", "source/demo/marble_run.d", "source/demo/_legacy/*"],
            "libs": ["box3d", "m"],
            "versions": ["NoSDL", "NoWGPU"]
        },
        {
            "name": "test-physics-box3d",
            "targetType": "executable",
            "targetName": "game-engine-test-physics-box3d",
            "mainSourceFile": "source/demo/test_physics_box3d.d",
            "excludedSourceFiles": ["source/demo/main.d", "source/demo/benchmark.d", "source/demo/benchmark2.d", "source/demo/game.d", "source/demo/showcase.d", "source/demo/editor.d", "source/demo/test_physics.d", "source/demo/gc_benchmark.d", "source/demo/marble_run.d", "source/demo/_legacy/*"],
            "libs": ["box3d", "m"],
            "versions": ["NoSDL", "NoWGPU"]
        },
        {
            "name": "gc-benchmark",
            "targetType": "executable",
            "targetName": "game-engine-gc-benchmark",
            "mainSourceFile": "source/demo/gc_benchmark.d",
            "sourcePaths": ["source/demo"],
            "importPaths": ["source"],
            "excludedSourceFiles": ["source/demo/main.d", "source/demo/benchmark.d", "source/demo/benchmark2.d", "source/demo/game.d", "source/demo/showcase.d", "source/demo/editor.d", "source/demo/test_physics.d", "source/demo/test_physics_box3d.d", "source/demo/marble_run.d", "source/demo/_legacy/*"],
            "libs": [],
            "versions": ["NoSDL", "NoWGPU"],
            "dflags-release-ldc": ["-O3", "-mcpu=native"]
        },
        {
            "name": "marble-run",
            "targetType": "executable",
            "targetName": "marble-run",
            "mainSourceFile": "source/demo/marble_run.d",
            "excludedSourceFiles": ["source/demo/main.d", "source/demo/benchmark.d", "source/demo/benchmark2.d", "source/demo/game.d", "source/demo/showcase.d", "source/demo/editor.d", "source/demo/test_physics.d", "source/demo/test_physics_box3d.d", "source/demo/gc_benchmark.d", "source/demo/_legacy/*"]
        },
        {
            "name": "library",
            "targetType": "library",
            "targetName": "game-engine",
            "excludedSourceFiles": ["source/demo/*", "source/demo/_legacy/*"]
        }
    ]
}
