{
    "name": "game-engine",
    "description": "Modern 3D game engine in D — WGPU + SDL3",
    "authors": ["Leonardo Tada"],
    "copyright": "Copyright © 2022-2026, Leonardo Tada",
    "license": "proprietary",

    "sourcePaths": ["source/engine", "source/bindings", "source/demo"],
    "importPaths": ["source"],

    "dflags": ["-preview=dip1000"],

    "libs": ["SDL3", "wgpu_native"],
    "lflags-linux": ["-L./libs"],

    "configurations": [
        {
            "name": "demo",
            "targetType": "executable",
            "targetName": "game-engine-demo"
        },
        {
            "name": "library",
            "targetType": "library",
            "targetName": "game-engine",
            "excludedSourceFiles": ["source/demo/*"]
        }
    ]
}
