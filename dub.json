{
    "name": "game-engine",
    "description": "Modern 3D game engine in D — WGPU + SDL3",
    "authors": ["Leonardo Tada"],
    "copyright": "Copyright © 2022-2026, Leonardo Tada",
    "license": "proprietary",

    "sourcePaths": ["source/engine", "source/bindings", "source/demo"],
    "importPaths": ["source"],

    "dflags": ["-preview=dip1000"],

    "libs": ["SDL3", "wgpu_native"],
    "lflags-linux": ["-L./libs"],

    "configurations": [
        {
            "name": "demo",
            "targetType": "executable",
            "targetName": "game-engine-demo",
            "mainSourceFile": "source/demo/main.d",
            "excludedSourceFiles": ["source/demo/benchmark.d", "source/demo/game.d", "source/demo/showcase.d", "source/demo/editor.d", "source/demo/test_physics.d", "source/demo/gc_benchmark.d", "source/demo/_legacy/*"]
        },
        {
            "name": "benchmark",
            "targetType": "executable",
            "targetName": "game-engine-benchmark",
            "mainSourceFile": "source/demo/benchmark.d",
            "excludedSourceFiles": ["source/demo/main.d", "source/demo/game.d", "source/demo/showcase.d", "source/demo/editor.d", "source/demo/test_physics.d", "source/demo/gc_benchmark.d", "source/demo/_legacy/*"],
            "dflags-release-ldc": ["-O3", "-mcpu=native"]
        },
        {
            "name": "game",
            "targetType": "executable",
            "targetName": "crystal-collector",
            "mainSourceFile": "source/demo/game.d",
            "excludedSourceFiles": ["source/demo/main.d", "source/demo/benchmark.d", "source/demo/showcase.d", "source/demo/editor.d", "source/demo/test_physics.d", "source/demo/gc_benchmark.d", "source/demo/_legacy/*"]
        },
        {
            "name": "showcase",
            "targetType": "executable",
            "targetName": "game-engine-showcase",
            "mainSourceFile": "source/demo/showcase.d",
            "excludedSourceFiles": ["source/demo/main.d", "source/demo/benchmark.d", "source/demo/game.d", "source/demo/editor.d", "source/demo/test_physics.d", "source/demo/gc_benchmark.d", "source/demo/_legacy/*"]
        },
        {
            "name": "editor",
            "targetType": "executable",
            "targetName": "game-engine-editor",
            "mainSourceFile": "source/demo/editor.d",
            "excludedSourceFiles": ["source/demo/main.d", "source/demo/benchmark.d", "source/demo/game.d", "source/demo/showcase.d", "source/demo/test_physics.d", "source/demo/gc_benchmark.d", "source/demo/_legacy/*"]
        },
        {
            "name": "test-physics",
            "targetType": "executable",
            "targetName": "game-engine-test-physics",
            "mainSourceFile": "source/demo/test_physics.d",
            "excludedSourceFiles": ["source/demo/main.d", "source/demo/benchmark.d", "source/demo/game.d", "source/demo/showcase.d", "source/demo/editor.d", "source/demo/gc_benchmark.d", "source/demo/_legacy/*"],
            "libs": [],
            "versions": ["NoSDL", "NoWGPU"]
        },
        {
            "name": "gc-benchmark",
            "targetType": "executable",
            "targetName": "game-engine-gc-benchmark",
            "mainSourceFile": "source/demo/gc_benchmark.d",
            "sourcePaths": ["source/demo"],
            "importPaths": ["source"],
            "excludedSourceFiles": ["source/demo/main.d", "source/demo/benchmark.d", "source/demo/game.d", "source/demo/showcase.d", "source/demo/editor.d", "source/demo/test_physics.d", "source/demo/_legacy/*"],
            "libs": [],
            "versions": ["NoSDL", "NoWGPU"],
            "dflags-release-ldc": ["-O3", "-mcpu=native"]
        },
        {
            "name": "library",
            "targetType": "library",
            "targetName": "game-engine",
            "excludedSourceFiles": ["source/demo/*", "source/demo/_legacy/*"]
        }
    ]
}
